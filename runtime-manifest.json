  "statusDefinitions": {
    "BASE_DIRECT": "Loaded directly by the application HTML before the additive runtime bootstrap. It may be foundational without owning the final visible UI.",
    "FINAL_OWNER": "Known current owner/finalizer for a visible runtime area. Later modules may still decorate it.",
    "COMPATIBILITY": "Required bridge, adapter, safety wrapper or migration layer. Do not infer UI ownership from this file.",
    "LOADED_LEGACY_CANDIDATE": "Still loaded in production but likely superseded in visible behavior. Must not be removed until callers, globals, events and smoke tests are traced.",
    "ACTIVE_PROVIDER": "Conditionally active runtime provider loaded outside the main bootstrap.",
    "DYNAMIC_CURRENT": "Current production module loaded dynamically by another current runtime file rather than by the main ordered bootstrap.",
    "LOADED_CURRENT_UNCLASSIFIED": "Loaded by the production bootstrap and therefore treated as required until explicitly classified."
  },
